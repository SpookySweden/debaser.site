{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "dev-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "NEXT_PUBLIC_SUPABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=",
        "NEXT_PUBLIC_WATCH_DATA_SOURCE=mock",
        "NEXT_PUBLIC_MEDIA_DATA_SOURCE=mock",
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3210"
      ],
      "port": 3210
    }
  ]
}