{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|mcp__.*__(execute_sql|apply_migration|create_branch|delete_branch|merge_branch|rebase_branch|reset_branch|restore_project|deploy_edge_function|create_project|pause_project|confirm_cost)|mcp__492da935-e635-431e-af65-3db428409e1c__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\" stop",
            "timeout": 180,
            "statusMessage": "Typechecking..."
          }
        ]
      }
    ]
  }
}
