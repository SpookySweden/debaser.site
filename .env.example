# ---------------------------------------------------------------------------
# DEBASER.SITE environment
#
# Copy this to `.env.local` for local work, and set the same names in the Vercel
# project for the deployed site. Only NEXT_PUBLIC_* values reach the browser,
# which is fine here: the publishable (anon) key is meant to be public, and Row
# Level Security in supabase/schema.sql is what protects the data.
# ---------------------------------------------------------------------------

# The Supabase project: Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Where each part of the site keeps its data.
#
# Every switch falls back to the local mock store when it is missing - or when the
# two keys above are not set - so the site runs with no backend at all, and each
# part can be moved over on its own.
#
# Run supabase/schema.sql in the Supabase SQL editor FIRST: these switches point
# the site at tables that have to exist, and the new-user trigger in that script is
# what gives every account - email or Google - a profile of its own.
NEXT_PUBLIC_AUTH_BACKEND=supabase
NEXT_PUBLIC_FORUM_DATA_SOURCE=supabase
NEXT_PUBLIC_PROFILE_DATA_SOURCE=supabase
NEXT_PUBLIC_COMMS_DATA_SOURCE=supabase

# Google sign-in also needs Authentication -> Providers -> Google enabled in the
# dashboard, with the client id and secret from Google Cloud and <site>/account in
# the redirect allow-list. Until then the button says what is missing rather than
# pretending.
#
# "Confirm email" is on by default, and with Supabase's built-in mail service a
# stranger cannot finish signing up: the confirmation mail never arrives. Turn that
# switch off (or add your own SMTP) so an account works as soon as it is made - see
# supabase/README.md, step 5.
#
# Production builds read `.env.production` as well, which is committed with these
# same values so the deploy needs no dashboard step. Names set in the Vercel project
# win over that file - see its header.
NEXT_PUBLIC_MUSIC_DATA_SOURCE=supabase

# The lore pages are the one part whose table has its own file: run
# supabase/migrations/20260929_lore_pages.sql (or section 22 of schema.sql) before
# the build that puts a page up, or the shelf says so rather than pretending to be
# empty. Temp/check-lore-schema.cjs asks the project whether it is there.
NEXT_PUBLIC_LORE_DATA_SOURCE=supabase

# The feed of tags and replies follows the board's switch, so a project that is on
# Supabase needs nothing here - uncommenting this line is how the bell is moved back
# to the local store on its own, which is what a project without
# supabase/migrations/20260923_notifications.sql (section 17) is looking at: the
# board would be live and the feed would say which file to run.
# Temp/check-notifications-schema.cjs asks the project whether the table is there,
# and exercises its policies when it is.
# NEXT_PUBLIC_NOTIFICATIONS_DATA_SOURCE=mock

# The arcade's invitations follow the board too, for the same reason: a challenge is one
# account asking another for a game, and it lives where the accounts already meet. A
# project without supabase/migrations/20260930_arcade.sql (section 23) reads as an empty
# arcade rather than a broken page - solo play needs no table at all.
# NEXT_PUBLIC_GAMES_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Running SQL from this checkout (optional, and not part of the site)
# ---------------------------------------------------------------------------
# Everything above is a NEXT_PUBLIC_* value: it goes into the bundle and points the running
# site at a project. This last one is different, and it is the only value in the file that
# is a secret. It is never read by app/ and never needed to build or to run the site - it
# is for the Supabase CLI, so a command here can ask the database a question directly
# instead of going through the publishable key (which can read tables and call functions,
# and cannot run SQL at all).
#
#   npm run db -- "select count(*) from public.profiles;"
#   npm run db -- --file supabase/cleanup/verify-live-schema.sql
#
# It is a *personal* access token (sbp_...) from
# https://supabase.com/dashboard/account/tokens, and it belongs to your account rather
# than to this site: it reaches every project you can see, and it can do anything to them.
# Keep it in .env.local (gitignored), never in .env.production or anywhere under app/.
#
# Run `npx supabase login` instead if you would rather not keep it in a file: that stores
# a token for the machine, and this line can stay commented out.
#
# After either one, link the checkout once so the CLI knows which project `--linked` means
# (it asks for the database password, from Dashboard -> Project Settings -> Database):
#
#   npm run db:link -- --project-ref <project-ref>
#
# SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# ---------------------------------------------------------------------------
# The database password (optional, and only for the Supabase CLI)
# ---------------------------------------------------------------------------
# Most queries go through the Management API and need nothing but the token above. But
# some statements make the CLI open a *direct* Postgres connection as a temporary login
# role, and that needs the database password; without it those calls fail with
# `password authentication failed for user "cli_login_postgres"` and the suggestion
# "Connect to your database by setting the env var correctly: SUPABASE_DB_PASSWORD".
#
# In practice that is intermittent, which is what makes it confusing: the CLI only takes
# the direct route when it decides it has to, so the same query can succeed four times
# and fail on the fifth. Setting this removes the whole class of failure.
#
# The password is the one from Dashboard -> Project Settings -> Database, the same one
# `npm run db:link` asks for. It is a real database credential - more powerful than the
# publishable key - so it belongs here in .env.local with the token, never in
# .env.production and never anywhere under app/.
#
# SUPABASE_DB_PASSWORD=your_database_password
