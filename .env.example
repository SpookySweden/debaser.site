# ---------------------------------------------------------------------------
# DEBASER.SITE environment
#
# Copy this to `.env.local` for local work, and set the same names in the Vercel
# project for the deployed site. Only NEXT_PUBLIC_* values reach the browser,
# which is fine here: the publishable (anon) key is meant to be public, and Row
# Level Security in supabase/schema.sql is what protects the data.
# ---------------------------------------------------------------------------

# The Supabase project: Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Where each part of the site keeps its data.
#
# Every switch falls back to the local mock store when it is missing - or when the
# two keys above are not set - so the site runs with no backend at all, and each
# part can be moved over on its own.
#
# Run supabase/schema.sql in the Supabase SQL editor FIRST: these switches point
# the site at tables that have to exist, and the new-user trigger in that script is
# what gives every account - email or Google - a profile of its own.
NEXT_PUBLIC_AUTH_BACKEND=supabase
NEXT_PUBLIC_FORUM_DATA_SOURCE=supabase
NEXT_PUBLIC_PROFILE_DATA_SOURCE=supabase
NEXT_PUBLIC_COMMS_DATA_SOURCE=supabase

# Google sign-in also needs Authentication -> Providers -> Google enabled in the
# dashboard, with the client id and secret from Google Cloud and <site>/account in
# the redirect allow-list. Until then the button says what is missing rather than
# pretending.
#
# "Confirm email" is on by default, and with Supabase's built-in mail service a
# stranger cannot finish signing up: the confirmation mail never arrives. Turn that
# switch off (or add your own SMTP) so an account works as soon as it is made - see
# supabase/README.md, step 5.
#
# Production builds read `.env.production` as well, which is committed with these
# same values so the deploy needs no dashboard step. Names set in the Vercel project
# win over that file - see its header.
NEXT_PUBLIC_MUSIC_DATA_SOURCE=supabase

# The lore pages are the one part whose table has its own file: run
# supabase/migrations/20260929_lore_pages.sql (or section 22 of schema.sql) before
# the build that puts a page up, or the shelf says so rather than pretending to be
# empty. Temp/check-lore-schema.cjs asks the project whether it is there.
NEXT_PUBLIC_LORE_DATA_SOURCE=supabase
