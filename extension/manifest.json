{
  "manifest_version": 3,
  "name": "DEBASER SEEING MACHINE",
  "version": "0.2.0",
  "description": "Own eye for debaser.site: pages in your own browser, where you are signed in, through the machine's lenses.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "DEBASER SEEING MACHINE"
  },
  "externally_connectable": {
    "matches": [
      "https://debaser.site/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "incognito": "not_allowed"
}
