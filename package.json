{
  "name": "debaser.site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "read": "node scripts/read-site.cjs",
    "read:local": "node scripts/read-site.cjs --local",
    "capture": "node scripts/capture-qa.cjs",
    "db": "node Temp/sql.cjs",
    "db:link": "supabase link",
    "db:list": "node Temp/db-cli.cjs migration list",
    "db:pull": "node Temp/db-cli.cjs db pull",
    "db:push": "node Temp/db-cli.cjs db push --include-all --yes",
    "db:push:dry": "node Temp/db-cli.cjs db push --dry-run --include-all",
    "db:new": "supabase migration new",
    "db:repair:applied": "node Temp/db-repair.cjs --applied",
    "db:repair:list": "node Temp/db-repair.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
